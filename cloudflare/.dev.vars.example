# Run npm run setup:local to generate your own local-only password.
# Never reuse this example or a development password in production.
# This is the bootstrap/recovery secret. Later password changes use the original account panel.
AUTH_PASSWORD=replace-with-your-own-password
# setup:local also generates a separate 32-byte base64 DATA_KEY. Do not replace an existing key.
# Configure HTTPS model URLs and model API keys in the original frontend.
